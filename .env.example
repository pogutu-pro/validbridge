# =============================================================================
# ValidBridge Environment Configuration
# =============================================================================

# Domain & Application URLs
VALIDBRIDGE_DOMAIN=localhost:3000
HTTP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Frontend Variables (NEXT_PUBLIC_*)
NEXT_PUBLIC_VALIDBRIDGE_API_URL=http://localhost:8000/api/v1/
NEXT_PUBLIC_VALIDBRIDGE_BACKEND_URL=http://localhost:8000/
NEXT_PUBLIC_VALIDBRIDGE_DOMAIN=localhost:3000
NEXT_PUBLIC_VALIDBRIDGE_TOP_DOMAIN=localhost
NEXT_PUBLIC_VALIDBRIDGE_MULTI_ORG=False
NEXT_PUBLIC_VALIDBRIDGE_DEFAULT_ORG=default
NEXT_PUBLIC_VALIDBRIDGE_HTTPS=False
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=validbridge-secret-key-change-in-production-32bytes-min

# PostgreSQL Database Configuration
POSTGRES_USER=validbridge
POSTGRES_PASSWORD=validbridge
POSTGRES_DB=validbridge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
VALIDBRIDGE_SQL_CONNECTION_STRING=postgresql+asyncpg://validbridge:validbridge@localhost:5432/validbridge

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
VALIDBRIDGE_REDIS_CONNECTION_STRING=redis://localhost:6379/validbridge
VALIDBRIDGE_REDIS_URL=redis://localhost:6379/validbridge

# Backend Server Configuration
VALIDBRIDGE_PORT=9000
HOSTNAME=0.0.0.0
VALIDBRIDGE_COOKIE_DOMAIN=.localhost
VALIDBRIDGE_AUTH_JWT_SECRET_KEY=validbridge-jwt-secret-key-32bytes-min

# Tenancy. "single" serves the default org on any host (localhost/self-host).
# "multi" enables per-org subdomains (slug.{VALIDBRIDGE_DOMAIN}) and requires
# the EE overlay + a non-localhost domain. For production subdomains set:
#   VALIDBRIDGE_TENANCY=multi
#   VALIDBRIDGE_COOKIE_DOMAIN=.yourdomain.tld
#   VALIDBRIDGE_COOKIE_DOMAIN_ALLOW_BROAD=true
#   NEXT_PUBLIC_VALIDBRIDGE_MULTI_ORG=True
#   NEXT_PUBLIC_VALIDBRIDGE_TOP_DOMAIN=yourdomain.tld
VALIDBRIDGE_TENANCY=single
VALIDBRIDGE_COOKIE_DOMAIN_ALLOW_BROAD=

# Initial Admin & Organization Setup
VALIDBRIDGE_INITIAL_ADMIN_EMAIL=admin@validbridge.dev
VALIDBRIDGE_INITIAL_ADMIN_PASSWORD=your-secure-password
VALIDBRIDGE_INITIAL_ORG_NAME=ValidBridge
VALIDBRIDGE_INITIAL_ORG_SLUG=default

# Collaboration Service Key
COLLAB_INTERNAL_KEY=validbridge-collab-internal-key-32bytes

# Payments (Paystack) — platform-level fallback credentials. Each organization
# may instead configure its own Paystack keys via the dashboard (stored on the
# org's PaymentsConfig row). Webhook signatures are verified against the
# account's secret key.
VALIDBRIDGE_PAYSTACK_SECRET_KEY=
VALIDBRIDGE_PAYSTACK_PUBLIC_KEY=

# SSO (Single Sign-On) — platform-level provider credentials. Secrets live here
# (and in config.yaml), never in the per-org SSOConfig DB row. A provider is
# "available" in the admin UI only when its required values are non-empty.
VALIDBRIDGE_SSO_ENABLED=
VALIDBRIDGE_WORKOS_CLIENT_ID=
VALIDBRIDGE_WORKOS_CLIENT_SECRET=
VALIDBRIDGE_WORKOS_REDIRECT_URI=
VALIDBRIDGE_OIDC_CLIENT_ID=
VALIDBRIDGE_OIDC_CLIENT_SECRET=
VALIDBRIDGE_OIDC_ISSUER=
VALIDBRIDGE_OIDC_AUTHORIZATION_ENDPOINT=
VALIDBRIDGE_OIDC_TOKEN_ENDPOINT=
VALIDBRIDGE_OIDC_USERINFO_ENDPOINT=
VALIDBRIDGE_OIDC_REDIRECT_URI=

# Email (Resend or SMTP) — magic-link login, verification, invites, nudges.
VALIDBRIDGE_EMAIL_PROVIDER=resend
VALIDBRIDGE_RESEND_API_KEY=
VALIDBRIDGE_RESEND_WEBHOOK_SECRET=
VALIDBRIDGE_SYSTEM_EMAIL_ADDRESS=
VALIDBRIDGE_SYSTEM_EMAIL_SENDER_NAME=ValidBridge
VALIDBRIDGE_SMTP_HOST=
VALIDBRIDGE_SMTP_PORT=587
VALIDBRIDGE_SMTP_USERNAME=
VALIDBRIDGE_SMTP_PASSWORD=
VALIDBRIDGE_SMTP_USE_TLS=true

# AI (provider-agnostic; Google/Gemini uses AI_API_KEY + GEMINI_API_KEY).
VALIDBRIDGE_IS_AI_ENABLED=false
VALIDBRIDGE_AI_PROVIDER=google
VALIDBRIDGE_AI_API_KEY=
VALIDBRIDGE_AI_BASE_URL=
VALIDBRIDGE_GEMINI_API_KEY=
VALIDBRIDGE_AI_MODEL_FAST=
VALIDBRIDGE_AI_MODEL_STANDARD=
VALIDBRIDGE_AI_MODEL_PRO=
VALIDBRIDGE_AI_EMBEDDING_PROVIDER=
VALIDBRIDGE_AI_EMBEDDING_MODEL=
VALIDBRIDGE_AI_EMBEDDING_DIMENSIONS=
VALIDBRIDGE_AI_IMAGE_MODEL=
VALIDBRIDGE_AI_TTS_MODEL=

# Analytics (Tinybird) — auto-enabled when API URL + tokens are set.
VALIDBRIDGE_TINYBIRD_API_URL=
VALIDBRIDGE_TINYBIRD_INGEST_TOKEN=
VALIDBRIDGE_TINYBIRD_READ_TOKEN=

# Code execution (Judge0) — auto-enabled when API URL is set.
VALIDBRIDGE_JUDGE0_API_URL=
VALIDBRIDGE_JUDGE0_CLIENT_ID=
VALIDBRIDGE_JUDGE0_CLIENT_SECRET=

# Google sign-in (OAuth client id used for ID-token audience verification).
VALIDBRIDGE_GOOGLE_OAUTH_CLIENT_ID=
VALIDBRIDGE_GOOGLE_CLIENT_ID=

# Error monitoring (Sentry).
VALIDBRIDGE_SENTRY_DSN=

# Marketing email (Loops).
LOOPS_API_KEY=
