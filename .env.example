# =============================================================================
# ValidBridge Environment Configuration
# =============================================================================

# Domain & Application URLs
VALIDBRIDGE_DOMAIN=localhost:3000
HTTP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Frontend Variables (NEXT_PUBLIC_*)
NEXT_PUBLIC_VALIDBRIDGE_API_URL=http://localhost:8000/api/v1/
NEXT_PUBLIC_VALIDBRIDGE_BACKEND_URL=http://localhost:8000/
NEXT_PUBLIC_VALIDBRIDGE_DOMAIN=localhost:3000
NEXT_PUBLIC_VALIDBRIDGE_TOP_DOMAIN=localhost
NEXT_PUBLIC_VALIDBRIDGE_MULTI_ORG=False
NEXT_PUBLIC_VALIDBRIDGE_DEFAULT_ORG=default
NEXT_PUBLIC_VALIDBRIDGE_HTTPS=False
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=validbridge-secret-key-change-in-production-32bytes-min

# PostgreSQL Database Configuration
POSTGRES_USER=validbridge
POSTGRES_PASSWORD=validbridge
POSTGRES_DB=validbridge
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
VALIDBRIDGE_SQL_CONNECTION_STRING=postgresql+asyncpg://validbridge:validbridge@localhost:5432/validbridge

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
VALIDBRIDGE_REDIS_CONNECTION_STRING=redis://localhost:6379/validbridge
VALIDBRIDGE_REDIS_URL=redis://localhost:6379/validbridge

# Backend Server Configuration
VALIDBRIDGE_PORT=9000
HOSTNAME=0.0.0.0
VALIDBRIDGE_COOKIE_DOMAIN=.localhost
VALIDBRIDGE_AUTH_JWT_SECRET_KEY=validbridge-jwt-secret-key-32bytes-min

# Initial Admin & Organization Setup
VALIDBRIDGE_INITIAL_ADMIN_EMAIL=admin@validbridge.dev
VALIDBRIDGE_INITIAL_ADMIN_PASSWORD=your-secure-password
VALIDBRIDGE_INITIAL_ORG_NAME=ValidBridge
VALIDBRIDGE_INITIAL_ORG_SLUG=default

# Collaboration Service Key
COLLAB_INTERNAL_KEY=validbridge-collab-internal-key-32bytes
