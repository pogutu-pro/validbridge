# =============================================================================
# ValidBridge / LearnHouse Environment Configuration
# =============================================================================

# Domain & Application URLs
LEARNHOUSE_DOMAIN=localhost:3000
HTTP_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Frontend Variables (NEXT_PUBLIC_*)
NEXT_PUBLIC_LEARNHOUSE_API_URL=http://localhost:8000/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=http://localhost:8000/
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=localhost:3000
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=localhost
NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default
NEXT_PUBLIC_LEARNHOUSE_HTTPS=False
NEXT_PUBLIC_COLLAB_URL=ws://localhost:4000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=validbridge-secret-key-change-in-production-32bytes-min

# PostgreSQL Database Configuration
POSTGRES_USER=learnhouse
POSTGRES_PASSWORD=learnhouse
POSTGRES_DB=learnhouse
POSTGRES_HOST=db
POSTGRES_PORT=5432
LEARNHOUSE_SQL_CONNECTION_STRING=postgresql://learnhouse:learnhouse@db:5432/learnhouse

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
LEARNHOUSE_REDIS_CONNECTION_STRING=redis://redis:6379/learnhouse
LEARNHOUSE_REDIS_URL=redis://redis:6379/learnhouse

# Backend Server Configuration
LEARNHOUSE_PORT=9000
HOSTNAME=0.0.0.0
LEARNHOUSE_COOKIE_DOMAIN=.localhost
LEARNHOUSE_AUTH_JWT_SECRET_KEY=validbridge-jwt-secret-key-32bytes-min

# Initial Admin & Organization Setup
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@validbridge.dev
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=your-secure-password
LEARNHOUSE_INITIAL_ORG_NAME=ValidBridge
LEARNHOUSE_INITIAL_ORG_SLUG=default

# Collaboration Service Key
COLLAB_INTERNAL_KEY=validbridge-collab-internal-key-32bytes
