# Piston API settings (read by config.js as PISTON_<UPPERCASE_NAME>).
# Requests may lower these per submission but can never exceed them.

PISTON_LOG_LEVEL=INFO
PISTON_BIND_ADDRESS=0.0.0.0:2000

# No network inside the sandbox (verified: outbound connect fails)
PISTON_DISABLE_NETWORKING=true

# Run stage
PISTON_RUN_TIMEOUT=5000               # wall clock, ms
PISTON_RUN_CPU_TIME=3000              # CPU time, ms (TLE -> status "TO")
PISTON_RUN_MEMORY_LIMIT=268435456     # 256 MB (bytes)

# Compile stage (C/C++/Java/Rust/...)
PISTON_COMPILE_TIMEOUT=15000
PISTON_COMPILE_CPU_TIME=10000
PISTON_COMPILE_MEMORY_LIMIT=536870912 # 512 MB

# Abuse limits per job
PISTON_MAX_PROCESS_COUNT=64           # fork bomb -> EAGAIN (verified)
PISTON_MAX_OPEN_FILES=256
PISTON_MAX_FILE_SIZE=10000000         # 10 MB per written file
PISTON_OUTPUT_MAX_SIZE=65536          # stdout/stderr cap -> status "OL"/"EL"

# Parallel jobs: about one per core (2 now, 4 after the resize)
PISTON_MAX_CONCURRENT_JOBS=2

# JVM languages, Dart, PowerShell and compilers need more than 256 MB / 3 s.
# Keys are Piston language names; values in bytes / ms.
PISTON_LIMIT_OVERRIDES={"java":{"run_memory_limit":536870912,"compile_memory_limit":805306368},"kotlin":{"run_memory_limit":536870912,"compile_memory_limit":1073741824,"compile_timeout":25000,"compile_cpu_time":25000},"scala":{"run_memory_limit":536870912,"compile_memory_limit":1073741824,"compile_timeout":25000,"compile_cpu_time":25000},"clojure":{"run_memory_limit":536870912,"run_cpu_time":8000,"run_timeout":10000},"dart":{"run_memory_limit":536870912,"run_cpu_time":6000,"run_timeout":8000},"powershell":{"run_memory_limit":536870912,"run_cpu_time":6000,"run_timeout":8000},"rust":{"compile_memory_limit":805306368},"typescript":{"compile_memory_limit":805306368,"compile_timeout":20000,"compile_cpu_time":20000}}

# Upstream index serves x86-64 packages; do not use ppman on ARM. Packages are
# built locally by build-arm64.sh. Point this at nothing reachable on purpose.
PISTON_REPO_URL=http://127.0.0.1:1/index
